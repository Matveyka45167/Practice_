n, k = map(int, input().split())

snow = [0] * (n + 1)
summa = [0] * (n + 1)

for _ in range(k):
    parts = input().split()
    query_id = int(parts[0])

    if query_id == 1:
        i = int(parts[1])
        x = int(parts[2])

        snow[i] += x

        for a in range(1, n + 1):
            summa[a] = summa[a - 1] + snow[a]
    else:
        u = int(parts[1])
        r = int(parts[2])

        res = summa[r] - summa[u - 1]
        print(res)
